{
  "name": "mdac-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "test": "vitest run",
    "verify": "npm run check && npm test && npm run build",
    "ocr:assets": "node scripts/copy-ocr-assets.mjs",
    "prebuild": "node scripts/copy-ocr-assets.mjs && node scripts/build-companion.mjs",
    "predev": "node scripts/copy-ocr-assets.mjs && node scripts/build-companion.mjs",
    "test:extension": "node tests/extension-e2e.mjs"
  },
  "dependencies": {
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/adapter-static": "4.0.0",
    "svelte": "^5.57.2",
    "idb": "^8.0.3",
    "read-excel-file": "^9.3.12",
    "tesseract.js": "^7.0.0",
    "fflate": "^0.8.2",
    "@tesseract.js-data/eng": "1.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "vite": "8.3.4",
    "svelte-check": "^4.3.3",
    "vitest": "5.0.4",
    "jsdom": "^27.0.0",
    "fake-indexeddb": "^6.2.4",
    "@playwright/test": "1.58.2",
    "typescript": "^6.0.0",
    "@opentelemetry/api": "^1.9.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
