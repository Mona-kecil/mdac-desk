{
  "name": "mdac-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "test": "vitest run",
    "verify": "npm run check && npm test && npm run build && npm run test:ocr",
    "ocr:assets": "node scripts/copy-ocr-assets.mjs",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "predev": "node scripts/copy-ocr-assets.mjs",
    "test:ocr": "node scripts/copy-ocr-assets.mjs && node scripts/test-ocr.mjs",
    "test:ocr:canvas": "node scripts/test-ocr-canvas.mjs",
    "browser:image": "node --env-file=.env.local scripts/prepare-browser-image.mjs",
    "test:remote": "node --env-file=.env.local tests/remote-runtime.mjs"
  },
  "dependencies": {
    "@sveltejs/adapter-vercel": "7.0.1",
    "@sveltejs/kit": "3.1.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@vercel/blob": "2.8.2",
    "@vercel/sandbox": "3.8.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "read-excel-file": "^9.3.12",
    "saxen": "^11.2.0",
    "svelte": "^5.57.2",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^27.0.0",
    "svelte-check": "^4.3.3",
    "typescript": "^6.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
